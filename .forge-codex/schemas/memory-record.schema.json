{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-conductor.local/schemas/memory-record.schema.json",
  "title": "Forge Conductor Project Memory Record",
  "type": "object",
  "required": ["schema_version", "id", "project_id", "version", "kind", "title", "summary", "provenance", "importance", "confidence", "created_at", "updated_at", "content_sha256", "tombstone"],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "kind": { "type": "string", "minLength": 1, "maxLength": 128 },
    "title": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 32768 },
    "body": { "type": ["string", "null"], "maxLength": 1048576 },
    "provenance": { "type": "object", "minProperties": 1, "additionalProperties": true },
    "importance": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tombstone": {
      "type": "object",
      "required": ["is_deleted"],
      "properties": {
        "is_deleted": { "type": "boolean" },
        "deleted_at": { "type": ["string", "null"], "format": "date-time" },
        "reason": { "type": ["string", "null"], "maxLength": 8192 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
