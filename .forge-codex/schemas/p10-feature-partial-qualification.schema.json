{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-conductor.local/schemas/p10-feature-partial-qualification.schema.json",
  "title": "P10 partial observations; not accepted full qualification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qualifier",
    "command",
    "execution",
    "environment",
    "timing",
    "source_identity",
    "results",
    "kind",
    "coverage",
    "supporting_cli"
  ],
  "properties": {
    "selection": {"type":"object","additionalProperties":false,"required":["feature_ids","scope","distribution_qualified","global_required_assertion_count","global_missing_assertion_ids","build_evidence_id","installation_evidence_id"],"properties":{"feature_ids":{"const":["CLI-VERSION-HELP"]},"scope":{"const":"development-installed-release"},"distribution_qualified":{"const":false},"global_required_assertion_count":{"const":259},"global_missing_assertion_ids":{"type":"array","minItems":257,"maxItems":257,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":300}},"build_evidence_id":{"type":"string","pattern":"^EVID-[A-Za-z0-9_-]{1,128}$"},"installation_evidence_id":{"type":"string","pattern":"^EVID-[A-Za-z0-9_-]{1,128}$"}}},
    "schema_version": {"type": "integer", "const": 3},
    "qualifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {"name": {"type": "string", "const": "forge-p10-production-matrix"}, "version": {"type": "integer", "const": 2}}
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "exit_code", "timed_out", "stream_limit_exceeded"],
      "properties": {
        "argv": {"type": "array", "minItems": 3, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "exit_code": {"type": "integer", "const": 2},
        "timed_out": {"type": "boolean", "const": false},
        "stream_limit_exceeded": {"type": "boolean", "const": false}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "assertion_count", "passed_assertion_count", "failed_assertion_count"],
      "properties": {
        "count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "assertion_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "passed_assertion_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "failed_assertion_count": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "platform",
        "architecture",
        "macos_build",
        "machine_identifier",
        "configuration",
        "installed_product",
        "installation_receipt"
      ],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "maxLength": 4096},
        "platform": {"type": "string", "minLength": 1, "maxLength": 4096},
        "architecture": {"type": "string", "minLength": 1, "maxLength": 256},
        "macos_build": {"type": "string", "minLength": 1, "maxLength": 256},
        "machine_identifier": {"type": "string", "minLength": 1, "maxLength": 256},
        "configuration": {"enum": ["Release", "not_assessed"]},
        "installed_product": {"type": "boolean", "const": false},
        "installation_receipt": {"anyOf": [{"$ref": "#/$defs/installation_receipt"}, {"type": "null"}]}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "ended_at"],
      "properties": {"started_at": {"type": "string", "format": "date-time"}, "ended_at": {"type": "string", "format": "date-time"}}
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_head", "source_manifest", "registry_sha256", "probe_registry_sha256", "qualifier_sha256", "baseline_sha256"],
      "properties": {
        "git_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_manifest": {"$ref": "#/$defs/source_manifest"},
        "registry_sha256": {"$ref": "#/$defs/sha256"},
        "probe_registry_sha256": {"$ref": "#/$defs/sha256"},
        "qualifier_sha256": {"$ref": "#/$defs/sha256"},
        "baseline_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "results": {"type": "array", "minItems": 0, "maxItems": 104, "items": {"$ref": "#/$defs/feature_result"}},
    "kind": {"const": "p10-feature-partial-qualification"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_assertion_count", "mapped_assertion_count", "missing_assertion_count", "missing_assertions", "complete"],
      "properties": {
        "required_assertion_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "mapped_assertion_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "missing_assertion_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "missing_assertions": {"type": "array", "uniqueItems": true, "maxItems": 1000000, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "complete": {"const": false}
      }
    },
    "supporting_cli": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_path", "sha256", "bytes", "executed_case_count", "passed", "accepted_p10_assertions", "failures"],
          "properties": {
            "source_path": {"const": ".forge-codex/evidence/P10-cli-version-help-observations.json"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "bytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
            "executed_case_count": {"type": "integer", "minimum": 0, "maximum": 7},
            "passed": {"type": "boolean"},
            "accepted_p10_assertions": {"const": []},
            "failures": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 4096}}
          }
        }
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "installation_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "configuration", "process", "artifacts", "coherent_build_sha256"],
      "properties": {
        "root": {"type": "string", "pattern": "^/", "maxLength": 4096},
        "configuration": {"type": "string", "const": "Release"},
        "coherent_build_sha256": {"$ref": "#/$defs/sha256"},
        "process": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pid", "artifact_id", "executable_path", "executable_sha256"],
          "properties": {
            "pid": {"type": "integer", "minimum": 2},
            "artifact_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "executable_path": {"type": "string", "pattern": "^/", "maxLength": 4096},
            "executable_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact_id", "kind", "path", "sha256", "bytes"],
            "properties": {
              "artifact_id": {"type": "string", "minLength": 1, "maxLength": 256},
              "kind": {"type": "string", "enum": ["executable", "app-executable", "helper"]},
              "path": {"type": "string", "pattern": "^/", "maxLength": 4096},
              "sha256": {"$ref": "#/$defs/sha256"},
              "bytes": {"type": "integer", "minimum": 1, "maximum": 536870912}
            }
          }
        }
      }
    },
    "source_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "sha256", "file_count", "bytes"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1, "maximum": 32768},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 536870912}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scenario_id",
        "selector",
        "runner_kind",
        "runner_argv",
        "execution_receipt_sha256",
        "executed_tests",
        "observed_assertions",
        "passed",
        "result",
        "artifact_references"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,250}$"},
        "scenario_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,250}$"},
        "selector": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,250}$"},
        "runner_kind": {"type": "string", "enum": ["repository_qualification", "native_cli_version_help"]},
        "runner_argv": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "execution_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "executed_tests": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "observed_assertions": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "passed": {"type": "boolean"},
        "result": {"enum": ["passed", "failed"]},
        "artifact_references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_path", "scenario_id", "selector", "sha256"],
            "properties": {
              "source_path": {"type": "string", "const": ".forge-codex/evidence/P10-feature-production-observations.json"},
              "scenario_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,250}$"},
              "selector": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,250}$"},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable",
        "artifact_id",
        "path",
        "artifact_sha256",
        "artifact_bytes",
        "team_id",
        "identifier",
        "cdhash",
        "designated_requirement_sha256",
        "hardened_runtime"
      ],
      "properties": {
        "applicable": {"type": "boolean"},
        "artifact_id": {
          "type": ["string", "null"],
          "enum": ["forge-conductor-app", "forge-conductor-cli", "forge-filesystem-daemon", "forge-runtime-launcher", null]
        },
        "path": {"type": ["string", "null"], "maxLength": 4096},
        "artifact_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "artifact_bytes": {"type": ["integer", "null"], "minimum": 1, "maximum": 536870912},
        "team_id": {"type": ["string", "null"], "pattern": "^[A-Z0-9]{10}$"},
        "identifier": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
        "cdhash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "designated_requirement_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "hardened_runtime": {"type": ["boolean", "null"]}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable",
        "kind",
        "transport",
        "endpoint",
        "model",
        "real_provider",
        "provider_pid",
        "provider_executable_path",
        "provider_executable_sha256",
        "provider_executable_bytes",
        "challenge_nonce",
        "request_sha256",
        "response_sha256",
        "response_id",
        "request_base64",
        "response_base64"
      ],
      "properties": {
        "applicable": {"type": "boolean"},
        "kind": {"type": "string", "enum": ["lm_studio", "not_applicable"]},
        "transport": {"type": ["string", "null"], "enum": ["http", null]},
        "endpoint": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096},
        "model": {"type": ["string", "null"], "minLength": 1, "maxLength": 1024},
        "real_provider": {"type": "boolean"},
        "provider_pid": {"type": ["integer", "null"], "minimum": 2},
        "provider_executable_path": {"type": ["string", "null"], "maxLength": 4096},
        "provider_executable_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "provider_executable_bytes": {"type": ["integer", "null"], "minimum": 1, "maximum": 536870912},
        "challenge_nonce": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "request_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "response_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "response_id": {"type": ["string", "null"], "maxLength": 4096},
        "request_base64": {"type": ["string", "null"], "maxLength": 131072},
        "response_base64": {"type": ["string", "null"], "maxLength": 131072}
      }
    },
    "feature_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "status", "execution_count", "assertion_count", "assertions", "signing", "provider"],
      "properties": {
        "feature_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,250}$"},
        "status": {"enum": ["not_run", "partial", "failed", "passed"]},
        "execution_count": {"type": "integer", "minimum": 0, "maximum": 1024},
        "assertion_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "assertions": {"type": "array", "minItems": 0, "maxItems": 4096, "items": {"$ref": "#/$defs/assertion"}},
        "signing": {"$ref": "#/$defs/signing"},
        "provider": {"$ref": "#/$defs/provider"}
      }
    }
  }
}
