          }
        },
        "signing_identities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signingIdentity"
          }
        },
        "fixture_digests": {
          "type": "object",
          "required": [
            "before",
            "after"
          ],
          "properties": {
            "before": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fixtureDigest"
              }
            },
            "after": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fixtureDigest"
              }
            }
          },
          "additionalProperties": false
        },
        "mount_facts": {
          "$ref": "#/$defs/mountFacts"
        },
        "crash_point": {
          "$ref": "#/$defs/crashPoint"
        },
        "observed_result": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "properties": {
                "status": {
                  "const": "not_run"
                }
              },
              "required": [
                "status"
              ]
            }
          },
          "then": {
            "properties": {
              "raw_artifact_references": {
                "minItems": 1
              },
              "iterations": {
                "properties": {
                  "executed": {
                    "minimum": 1
                  }
                }
              },
              "barrier_evidence": {
                "minItems": 1
              },
              "process_identities": {
                "minItems": 1
              },
              "signing_identities": {
                "minItems": 1
              },
              "fixture_digests": {
                "properties": {
                  "before": {
                    "minItems": 1
                  },
                  "after": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
