            "$ref": "#/$defs/artifactReference"
          },
          "uniqueItems": true
        },
        "iterations": {
          "type": "object",
          "required": [
            "planned",
            "executed",
            "conclusive",
            "barrier_hits",
            "barrier_misses"
          ],
          "properties": {
            "planned": {
              "type": "integer",
              "minimum": 1
            },
            "executed": {
              "type": "integer",
              "minimum": 0
            },
            "conclusive": {
              "type": "integer",
              "minimum": 0
            },
            "barrier_hits": {
              "type": "integer",
              "minimum": 0
            },
            "barrier_misses": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "barrier_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/barrierObservation"
          }
        },
        "process_identities": {
          "type": "array",
          "items": {
