    "qualificationCase": {
      "type": "object",
      "required": [
        "contracts_exercised",
        "status",
        "raw_artifact_references",
        "iterations",
        "barrier_evidence",
        "process_identities",
        "signing_identities",
        "fixture_digests",
        "mount_facts",
        "crash_point",
        "observed_result"
